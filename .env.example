# Server-only Binance USD-M Futures Demo mirror configuration.
# Production Futures hosts are rejected by the application.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
BINANCE_FUTURES_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_ONLY=true
BINANCE_FUTURES_MARGIN_USDT=25
