# Server-only Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SCANNER_TRIGGER_KEY=

# Server-only Gmail SMTP configuration
FASTACT_EMAIL_SENDER=
FASTACT_EMAIL_APP_PASSWORD=
